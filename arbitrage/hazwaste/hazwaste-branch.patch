+#!/usr/bin/env python3
+"""Build the hazardous-waste license renewal tool at /hazwaste/.
+
+Two outputs, both committed:
+
+  website/api/_data/hazwaste_shops.json   the shops the lookup searches: every
+      active small generator the county license (Hennepin), EPA ECHO (all seven
+      counties) and MPCA hold, one row per EPA id. Public records only: name,
+      address, county, generator size, EPA id, what the shop is.
+  website/hazwaste/index.html             the page, one screen at a time.
+
+And one that is NOT committed (data/outreach is gitignored):
+
+  data/outreach/hazwaste/prospects.csv    the same shops joined to the website
+      and phone Overture observes on the same parcel or city+name, which is what
+      the contact-form channel needs.
+
+Reads data/arbitrage.duckdb, so run `scripts/arbitrage.py build` first.
+Grounded 2026-09-28: Aidan, "we should automate end to end for counties where
+we can. And for counties that dont we just give them the form they need to
+submit with instructions." Counties and their submit routes live in
+website/api/_data/hazwaste_counties.json (hand-verified against each county's
+own page; see its `source` fields).
+"""
+
+from __future__ import annotations
+
+import csv
+import html
+import json
+import sys
+from pathlib import Path
+
+import duckdb
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "scripts"))
+from nav_links import footer as _footer, topbar as _topbar  # noqa: E402
+from site_head import card as _card, icons as _icons  # noqa: E402
+
+DB = Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / "data" / "arbitrage.duckdb"
+if not DB.exists():
+    DB = Path("/Users/aidan/Desktop/bricks/data/arbitrage.duckdb")
+OUT_SHOPS = ROOT / "website" / "api" / "_data" / "hazwaste_shops.json"
+OUT_PAGE = ROOT / "website" / "hazwaste" / "index.html"
+OUT_PROSPECTS = ROOT / "data" / "outreach" / "hazwaste" / "prospects.csv"
+COUNTIES = ROOT / "website" / "api" / "_data" / "hazwaste_counties.json"
+
+METRO = ("hennepin", "ramsey", "anoka", "dakota", "washington", "scott", "carver")
+SMALL = ("licensed:VSQG", "licensed:MIG", "licensed:SQG", "licensed:unsized")
+SOURCES = ("hennepin_hazwaste", "echo_rcra", "mpca_wimn")
+
+# What the shop is, in the owner's words, for the waste checklist presets.
+KIND = [
+    ("auto", "auto"), ("automotive", "auto"), ("body", "auto"), ("gas_station", "auto"),
+    ("dent", "dental"), ("physician", "medical"), ("chiropract", "medical"), ("veterinar", "vet"), ("pharmacy", "medical"),
+    ("print", "print"), ("dry_clean", "dryclean"), ("laundr", "dryclean"), ("salon", "salon"), ("barber", "salon"),
+]
+
+
+NAME_KIND = [("DENTAL", "dental"), ("DENTIST", "dental"), ("ORTHODONT", "dental"), ("AUTO", "auto"), ("MOTOR", "auto"), ("COLLISION", "auto"),
+             ("TIRE", "auto"), ("LUBE", "auto"), ("TRANSMISSION", "auto"), ("CLEANERS", "dryclean"), ("DRY CLEAN", "dryclean"),
+             ("PRINT", "print"), ("GRAPHICS", "print"), ("SALON", "salon"), ("VETERINAR", "vet"), ("ANIMAL HOSP", "vet"), ("CLINIC", "medical")]
+
+
+def kind_for(category: str | None, sector: str | None, name: str | None = None) -> str:
+    c = (category or "").lower()
+    for needle, k in KIND:
+        if needle in c:
+            return k
+    n = (name or "").upper()
+    for needle, k in NAME_KIND:
+        if needle in n:
+            return k
+    return {"auto": "auto", "health": "medical", "salon": "salon"}.get(sector or "", "other")
+
+
+def shops(con) -> list[dict]:
+    rows = con.execute(f"""
+        SELECT COALESCE(epa_id, id) AS key, name, address, city, postcode, county, status, category, sector, epa_id, source_id
+        FROM business
+        WHERE source_id IN {SOURCES} AND status IN {SMALL} AND county IN {METRO} AND name <> ''
+        QUALIFY row_number() OVER (PARTITION BY COALESCE(epa_id, id)
+                                   ORDER BY CASE source_id WHEN 'hennepin_hazwaste' THEN 0 WHEN 'echo_rcra' THEN 1 ELSE 2 END) = 1
+        ORDER BY county, city, name
+    """).fetchall()
+    out = []
+    for key, name, addr, city, zp, county, status, cat, sector, epa, src in rows:
+        out.append({
+            "id": key, "name": " ".join((name or "").split()), "address": " ".join((addr or "").split()), "city": city or "",
+            "zip": (zp or "")[:5], "county": county, "size": status.split(":")[1], "epa_id": epa or "",
+            "kind": kind_for(cat, sector, name),
+        })
+    return out
+
+
+STOP = {"INC", "LLC", "CO", "CORP", "COMPANY", "LTD", "THE", "OF", "AND", "MN", "MINNESOTA", "PA", "PLLC", "DBA"}
+
+
+def _nm(s: str | None) -> str:
+    import re
+    return " ".join(t for t in re.split(r"[^A-Z0-9]+", (s or "").upper()) if t and t not in STOP)
+
+
+def same_business(a: str | None, b: str | None) -> bool:
+    """Two listings name one business when their cleaned names are close as a
+    whole, not when they share a first word (Stillwater Motor is not Stillwater
+    Trolley)."""
+    from difflib import SequenceMatcher
+    x, y = _nm(a), _nm(b)
+    if not x or not y:
+        return False
+    if x == y or x in y or y in x:
+        return True
+    return SequenceMatcher(None, x, y).ratio() >= 0.85
+
+
+def prospects(con) -> int:
+    rows = con.execute(f"""
+        WITH s AS (
+            SELECT * FROM business WHERE source_id IN {SOURCES} AND status IN {SMALL} AND county IN {METRO} AND name <> ''
+            QUALIFY row_number() OVER (PARTITION BY COALESCE(epa_id, id) ORDER BY source_id) = 1
+        ), o AS (
+            SELECT dedupe_key, site_id, city, website, phone, name FROM business WHERE source_id = 'bm_businesses' AND (website IS NOT NULL OR phone IS NOT NULL)
+        )
+        SELECT COALESCE(s.epa_id, s.id), s.epa_id, s.name, s.address, s.city, s.county, s.status, s.category, o.website, o.phone, o.name
+        FROM s LEFT JOIN o ON regexp_extract(o.dedupe_key, '[^|]*$') = regexp_extract(s.dedupe_key, '[^|]*$')
+                          AND (o.site_id = s.site_id OR UPPER(o.city) = UPPER(s.city))
+    """).fetchall()
+    best: dict[str, list] = {}
+    for key, epa, name, addr, city, county, status, cat, web, phone, lname in rows:
+        ok = lname is not None and same_business(name, lname)
+        cur = best.get(key)
+        rec = [epa, name, addr, city, county, status.split(":")[1], cat, web if ok else None, phone if ok else None, lname if ok else None]
+        if cur is None or (ok and not cur[7] and web):
+            best[key] = rec
+    OUT_PROSPECTS.parent.mkdir(parents=True, exist_ok=True)
+    with OUT_PROSPECTS.open("w", newline="") as fh:
+        w = csv.writer(fh)
+        w.writerow(["epa_id", "name", "address", "city", "county", "size", "category", "website", "phone", "listing_name"])
+        w.writerows(best.values())
+    return len(best)
+
+
+def e(s) -> str:
+    return html.escape(str(s), quote=True)
+
+
+def page(n_shops: int, counties: dict) -> str:
+    auto = sorted(c["name"] for c in counties.values() if c.get("mode") == "submit")
+    guided = sorted(c["name"] for c in counties.values() if c.get("mode") != "submit")
+    canonical = "https://brickandmortar.dev/hazwaste/"
+    return f"""<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Renew your hazardous waste license — free | Brick &amp; Mortar</title>
+<meta name="description" content="Minnesota metro shops renew a county hazardous waste generator license every year. Find your shop, confirm what you throw out, and we fill it in. Free.">
+<link rel="canonical" href="{canonical}">
+{_icons()}
+{_card("/hazwaste/", "Renew your county hazardous waste license, free")}
+<style>
+:root {{ --bg:#fbfaf7; --ink:#1b1b1b; --mute:#6b6b6b; --line:#e4e1da; --accent:#1f5f4a; --accent-ink:#fff; --warn:#8a4b00; --card:#fff; }}
+@media (prefers-color-scheme: dark) {{ :root:not([data-theme="light"]) {{ --bg:#141414; --ink:#ececec; --mute:#a0a0a0; --line:#2c2c2c; --accent:#5fb896; --accent-ink:#0b0b0b; --warn:#f0b35a; --card:#1c1c1c; }} }}
+:root[data-theme="dark"] {{ --bg:#141414; --ink:#ececec; --mute:#a0a0a0; --line:#2c2c2c; --accent:#5fb896; --accent-ink:#0b0b0b; --warn:#f0b35a; --card:#1c1c1c; }}
+* {{ box-sizing:border-box }}
+body {{ margin:0; background:var(--bg); color:var(--ink); font:17px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif }}
+main {{ max-width:560px; margin:0 auto; padding:24px 16px 64px }}
+h1 {{ font-size:28px; line-height:1.15; margin:8px 0 10px }}
+h2 {{ font-size:20px; margin:0 0 12px }}
+p.lede {{ font-size:18px; margin:0 0 20px; color:var(--ink) }}
+.mute {{ color:var(--mute); font-size:15px }}
+.step {{ display:none }} .step.on {{ display:block }}
+input[type=text], input[type=email], input[type=tel], input[type=number], select, textarea {{ width:100%; padding:13px 12px; font:inherit; border:1px solid var(--line); border-radius:10px; background:var(--card); color:var(--ink) }}
+label {{ display:block; font-weight:600; margin:14px 0 6px }}
+button {{ font:inherit; font-weight:650; border:0; border-radius:10px; padding:14px 16px; background:var(--accent); color:var(--accent-ink); width:100%; margin-top:18px; cursor:pointer }}
+button.ghost {{ background:transparent; color:var(--accent); border:1px solid var(--line) }}
+ul.hits {{ list-style:none; padding:0; margin:10px 0 0 }}
+ul.hits li {{ border:1px solid var(--line); background:var(--card); border-radius:10px; padding:12px; margin-top:8px; cursor:pointer }}
+ul.hits li b {{ display:block }}
+.waste {{ border:1px solid var(--line); background:var(--card); border-radius:10px; padding:10px 12px; margin-top:8px }}
+.waste > label {{ display:flex; gap:10px; align-items:center; margin:0; font-weight:600 }}
+.waste .qty {{ display:none; margin-top:8px; gap:8px }} .waste.on .qty {{ display:flex }}
+.waste .qty input {{ flex:1 }} .waste .qty select {{ flex:1 }}
+.done {{ border:1px solid var(--line); background:var(--card); border-radius:12px; padding:16px }}
+.done ol {{ padding-left:20px }}
+.pill {{ display:inline-block; font-size:13px; border:1px solid var(--line); border-radius:99px; padding:2px 8px; margin-right:6px; color:var(--mute) }}
+.err {{ color:var(--warn); margin-top:10px }}
+a {{ color:var(--accent) }}
+</style>
+</head>
+<body>
+{_topbar("")}
+<main>
+  <section class="step on" id="s1">
+    <h1>Your county hazardous waste license, renewed for you.</h1>
+    <p class="lede">Every shop that throws out used oil, solvent, antifreeze, fixer or paint needs one, every year. Find your shop and we fill it in. Free.</p>
+    <label for="q">Your shop's name or street address</label>
+    <input id="q" type="text" autocomplete="off" placeholder="e.g. Lake Street Auto">
+    <ul class="hits" id="hits"></ul>
+    <p class="mute">{n_shops:,} metro shops are on file from county, EPA and MPCA records. Not listed? <a href="#" id="notlisted">Start from scratch</a>.</p>
+  </section>
+
+  <section class="step" id="s2">
+    <h2>What does <span id="shopname">your shop</span> throw out?</h2>
+    <p class="mute">Tick each one and give a rough amount for the last 12 months. A guess is fine.</p>
+    <div id="wastes"></div>
+    <button id="to3">Next</button>
+    <button class="ghost" data-back="s1">Back</button>
+  </section>
+
+  <section class="step" id="s3">
+    <h2>Who signs it?</h2>
+    <label for="nm">Your name</label><input id="nm" type="text" autocomplete="name">
+    <label for="ti">Your title</label><input id="ti" type="text" placeholder="Owner">
+    <label for="em">Email</label><input id="em" type="email" autocomplete="email">
+    <label for="ph">Phone</label><input id="ph" type="tel" autocomplete="tel">
+    <label style="display:flex;gap:10px;font-weight:400;align-items:flex-start"><input id="ok" type="checkbox" style="margin-top:4px">
+      <span>I authorize Brick &amp; Mortar to prepare this renewal and, where my county accepts it, to submit it on my behalf. The information is true to the best of my knowledge.</span></label>
+    <button id="send">Prepare my renewal</button>
+    <button class="ghost" data-back="s2">Back</button>
+    <p class="err" id="err"></p>
+  </section>
+
+  <section class="step" id="s4">
+    <div class="done" id="result"></div>
+  </section>
+
+  <p class="mute" style="margin-top:36px">{e(("We send it to the county for you in " + ", ".join(auto) + ". Everywhere else we") if auto else "We")} hand you the filled form and the steps to send it. Records: Hennepin County, US EPA ECHO, MPCA.</p>
+</main>
+{_footer()}
+<script>
+const $ = (id) => document.getElementById(id);
+const WASTES = {{
+  used_oil: ["Used motor oil", "gal"], antifreeze: ["Used antifreeze", "gal"], solvent: ["Parts-washer solvent", "gal"],
+  oil_filters: ["Used oil filters", "count"], aerosols: ["Aerosol cans", "count"], paint: ["Paint and thinner waste", "gal"],
+  lamps: ["Fluorescent lamps / bulbs", "count"], batteries: ["Batteries", "count"], fixer: ["X-ray fixer / developer", "gal"],
+  amalgam: ["Dental amalgam / separator waste", "lb"], sharps_chem: ["Lab or cleaning chemicals", "gal"], ink: ["Ink, press wash, solvent rags", "gal"],
+  perc: ["Perc (dry-cleaning solvent) and residue", "gal"], hair_chem: ["Hair dye, perm and nail chemicals", "gal"], other: ["Something else", "gal"]
+}};
+const PRESET = {{ auto:["used_oil","antifreeze","solvent","oil_filters","aerosols","batteries","paint"], dental:["amalgam","fixer","sharps_chem","lamps"],
+  medical:["sharps_chem","fixer","lamps","batteries"], vet:["fixer","sharps_chem","lamps"], print:["ink","solvent","lamps","aerosols"],
+  dryclean:["perc","solvent","lamps"], salon:["hair_chem","aerosols","lamps"], other:["used_oil","solvent","paint","aerosols","lamps","batteries"] }};
+let shop = null;
+function show(id) {{ document.querySelectorAll(".step").forEach(s => s.classList.toggle("on", s.id === id)); window.scrollTo(0,0); }}
+document.querySelectorAll("[data-back]").forEach(b => b.onclick = () => show(b.dataset.back));
+let t; $("q").oninput = () => {{ clearTimeout(t); t = setTimeout(search, 180); }};
+async function search() {{
+  const q = $("q").value.trim(); const ul = $("hits"); ul.innerHTML = "";
+  if (q.length < 3) return;
+  const r = await fetch("/api/hazwaste?q=" + encodeURIComponent(q)).then(r => r.json()).catch(() => ({{hits:[]}}));
+  for (const h of r.hits) {{
+    const li = document.createElement("li");
+    li.innerHTML = `<b></b><span class="mute"></span>`;
+    li.querySelector("b").textContent = h.name;
+    li.querySelector("span").textContent = `${{h.address}}, ${{h.city}} · ${{h.county[0].toUpperCase()+h.county.slice(1)}} County`;
+    li.onclick = () => pick(h); ul.appendChild(li);
+  }}
+}}
+$("notlisted").onclick = (ev) => {{ ev.preventDefault(); const n = prompt("Shop name, street, city and county"); if (n) pick({{id:"", name:n, address:"", city:"", county:"", kind:"other", size:"", epa_id:""}}); }};
+function pick(h) {{
+  shop = h; $("shopname").textContent = h.name; const box = $("wastes"); box.innerHTML = "";
+  const order = [...(PRESET[h.kind] || PRESET.other), ...Object.keys(WASTES)].filter((v,i,a) => a.indexOf(v) === i);
+  for (const k of order) {{
+    const [label, unit] = WASTES[k]; const d = document.createElement("div"); d.className = "waste"; d.dataset.k = k;
+    d.innerHTML = `<label><input type="checkbox"> <span></span></label><div class="qty"><input type="number" min="0" inputmode="decimal" placeholder="Amount per year"><select><option>${{unit}}</option><option>gal</option><option>lb</option><option>count</option></select></div><input class="hauler" type="text" placeholder="Who takes it (hauler, or 'county drop-off')" style="display:none;margin-top:8px">`;
+    d.querySelector("span").textContent = label;
+    d.querySelector("input[type=checkbox]").onchange = (ev) => {{ d.classList.toggle("on", ev.target.checked); d.querySelector(".hauler").style.display = ev.target.checked ? "block" : "none"; }};
+    box.appendChild(d);
+  }}
+  show("s2");
+}}
+$("to3").onclick = () => show("s3");
+$("send").onclick = async () => {{
+  $("err").textContent = "";
+  const wastes = [...document.querySelectorAll(".waste.on")].map(d => ({{ key:d.dataset.k, amount:d.querySelector(".qty input").value, unit:d.querySelector(".qty select").value, hauler:d.querySelector(".hauler").value }}));
+  const body = {{ shop, wastes, signer:{{ name:$("nm").value, title:$("ti").value, email:$("em").value, phone:$("ph").value }}, authorized:$("ok").checked }};
+  if (!body.authorized) {{ $("err").textContent = "Tick the authorization so we can prepare it."; return; }}
+  if (!body.signer.name || !body.signer.email) {{ $("err").textContent = "Your name and email, so we can send you the finished renewal."; return; }}
+  $("send").disabled = true; $("send").textContent = "Preparing…";
+  const r = await fetch("/api/hazwaste", {{ method:"POST", headers:{{"Content-Type":"application/json"}}, body:JSON.stringify(body) }}).then(r => r.json()).catch(() => ({{error:"network"}}));
+  $("send").disabled = false; $("send").textContent = "Prepare my renewal";
+  if (r.error) {{ $("err").textContent = "That didn't go through. Try again, or email hello@brickandmortar.dev."; return; }}
+  $("result").innerHTML = r.html; show("s4");
+}};
+</script>
+</body>
+</html>
+"""
+
+
+def main() -> int:
+    con = duckdb.connect(str(DB), read_only=True)
+    s = shops(con)
+    OUT_SHOPS.write_text(json.dumps({"_comment": "Written by scripts/build_hazwaste.py — do not hand-edit. Active small hazardous-waste generators in the seven metro counties, one per EPA id, from the Hennepin County license layer, US EPA ECHO and MPCA.", "shops": s}, separators=(",", ":")))
+    n_p = prospects(con)
+    counties = json.loads(COUNTIES.read_text())["counties"]
+    OUT_PAGE.parent.mkdir(parents=True, exist_ok=True)
+    OUT_PAGE.write_text(page(len(s), counties))
+    print(f"wrote {OUT_SHOPS.relative_to(ROOT)}  {len(s):,} shops  {OUT_SHOPS.stat().st_size/1e6:.1f} MB")
+    print(f"wrote {OUT_PROSPECTS.relative_to(ROOT)}  {n_p:,} prospects")
+    print(f"wrote {OUT_PAGE.relative_to(ROOT)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
