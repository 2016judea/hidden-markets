+// The filled renewal: what the shop told us, laid out in the order a county's
+// hazardous-waste generator license renewal asks for it. One renderer for every
+// county; a county entry in hazwaste_counties.json names its own form, sections
+// and steps.
+
+export const WASTES = {
+  used_oil: ["Used motor oil", "gal", "Recycled — used oil collector"],
+  antifreeze: ["Used antifreeze", "gal", "Recycled — antifreeze recycler"],
+  solvent: ["Parts-washer / cleaning solvent", "gal", "Recycled — solvent service"],
+  oil_filters: ["Used oil filters", "count", "Recycled — scrap metal after draining"],
+  aerosols: ["Aerosol cans", "count", "Punctured and recycled, or hazardous waste hauler"],
+  paint: ["Paint and thinner waste", "gal", "Hazardous waste hauler or county collection"],
+  lamps: ["Fluorescent lamps / bulbs", "count", "Lamp recycler"],
+  batteries: ["Batteries", "count", "Battery recycler / core return"],
+  fixer: ["X-ray fixer / developer", "gal", "Silver recovery or hazardous waste hauler"],
+  amalgam: ["Dental amalgam / separator waste", "lb", "Amalgam recycler"],
+  sharps_chem: ["Lab or cleaning chemicals", "gal", "Hazardous waste hauler or county collection"],
+  ink: ["Ink, press wash, solvent rags", "gal", "Hazardous waste hauler / laundered shop towels"],
+  perc: ["Perc (dry-cleaning solvent) and residue", "gal", "Hazardous waste hauler"],
+  hair_chem: ["Hair dye, perm and nail chemicals", "gal", "Hazardous waste hauler or county collection"],
+  other: ["Other", "gal", ""],
+};
+
+const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+export function validateFiling(b) {
+  if (!b || typeof b !== "object") return "body";
+  if (!b.authorized) return "authorization";
+  if (!b.shop || !b.shop.name) return "shop";
+  if (!Array.isArray(b.wastes) || b.wastes.length > 20) return "wastes";
+  for (const w of b.wastes) if (!WASTES[w.key]) return "waste key";
+  const s = b.signer || {};
+  if (!s.name || String(s.name).length > 120) return "signer name";
+  if (!EMAIL.test(String(s.email || ""))) return "signer email";
+  return null;
+}
+
+const e = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
+
+export function renderRenewal(f, county) {
+  const shop = f.shop || {};
+  const rows = (f.wastes || []).map((w) => {
+    const [label, , method] = WASTES[w.key] || [w.key, "", ""];
+    return `<tr><td>${e(label)}</td><td>${e(w.amount || "—")} ${e(w.unit || "")}</td><td>${e(w.hauler || method)}</td></tr>`;
+  }).join("");
+  const form = county?.form_name ? `<p><b>Form:</b> ${e(county.form_name)}${county.form_url ? ` — <a href="${e(county.form_url)}">${e(county.form_url)}</a>` : ""}</p>` : "";
+  const steps = (county?.steps || []).map((s) => `<li>${e(s)}</li>`).join("");
+  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Hazardous waste generator license renewal — ${e(shop.name)}</title>
+<style>body{font:15px/1.45 system-ui,sans-serif;max-width:760px;margin:24px auto;padding:0 16px;color:#1b1b1b;background:#fff}
+h1{font-size:22px}h2{font-size:17px;margin-top:22px;border-bottom:1px solid #ddd;padding-bottom:4px}
+table{border-collapse:collapse;width:100%}td,th{border:1px solid #ddd;padding:6px 8px;text-align:left;vertical-align:top}
+.k{color:#555;width:38%}@media print{a{color:#000}}</style></head><body>
+<h1>Hazardous waste generator license — annual renewal</h1>
+<p>${e(county ? `${county.name} County` : "County")} · prepared ${e(f.at?.slice(0, 10))} by Brick &amp; Mortar on the business's authorization</p>
+${form}
+<h2>1. Business and site</h2>
+<table>
+<tr><td class="k">Business name</td><td>${e(shop.name)}</td></tr>
+<tr><td class="k">Site address</td><td>${e([shop.address, shop.city, "MN", shop.zip].filter(Boolean).join(", "))}</td></tr>
+<tr><td class="k">County</td><td>${e(county?.name || shop.county)}</td></tr>
+<tr><td class="k">EPA / MPCA hazardous waste ID</td><td>${e(shop.epa_id || "— (not on file; the county can look it up by address)")}</td></tr>
+<tr><td class="k">Generator size on record</td><td>${e(shop.size || "—")}</td></tr>
+</table>
+<h2>2. Hazardous wastes generated in the last 12 months</h2>
+<table><tr><th>Waste</th><th>Amount per year</th><th>Where it goes</th></tr>${rows || `<tr><td colspan="3">None reported</td></tr>`}</table>
+<h2>3. Contact and certification</h2>
+<table>
+<tr><td class="k">Name</td><td>${e(f.signer?.name)}</td></tr>
+<tr><td class="k">Title</td><td>${e(f.signer?.title || "Owner")}</td></tr>
+<tr><td class="k">Email</td><td>${e(f.signer?.email)}</td></tr>
+<tr><td class="k">Phone</td><td>${e(f.signer?.phone)}</td></tr>
+<tr><td class="k">Certification</td><td>I certify the information above is true to the best of my knowledge, and authorize Brick &amp; Mortar to prepare this renewal${county?.mode === "submit" ? " and submit it on my behalf" : ""}. Authorized online ${e(f.at)}.</td></tr>
+</table>
+${steps ? `<h2>How to send it</h2><ol>${steps}</ol>` : ""}
+<p style="color:#666;font-size:13px;margin-top:28px">Prepared from public records (Hennepin County, US EPA ECHO, MPCA) and the answers above. Check the amounts before you sign; the county's form is the one of record.</p>
+</body></html>`;
+}
diff --git a/website/api/_lib/hazwaste.test.js b/website/api/_lib/hazwaste.test.js
new file mode 100644
index 00000000..0dd5cd9c
--- /dev/null
+++ b/website/api/_lib/hazwaste.test.js
@@ -0,0 +1,47 @@
+// The renewal tool: search finds shops from the public record, a filing with
+// no authorization or no reachable signer is refused, the renewal renders the
+// shop's answers, and no county is sent anything unless it is both a "submit"
+// county and HAZWASTE_AUTOSUBMIT=1.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import handler, { search } from "../hazwaste.js";
+import { renderRenewal, validateFiling } from "./hazwaste.js";
+import counties from "../_data/hazwaste_counties.json" with { type: "json" };
+
+const res = () => ({ code: 0, body: null, setHeader() {}, status(c) { this.code = c; return this; }, json(o) { this.body = o; return this; } });
+const good = (shop) => ({ shop, wastes: [{ key: "used_oil", amount: "120", unit: "gal", hauler: "" }], signer: { name: "Pat Owner", email: "pat@example.com" }, authorized: true });
+
+test("search finds shops by name and street, and ignores one-letter noise", () => {
+  const hits = search("auto minneapolis");
+  assert.ok(hits.length > 0 && hits.length <= 8);
+  assert.ok(hits.every((h) => /AUTO/i.test(`${h.name} ${h.address}`) && h.city === "Minneapolis"));
+  assert.deepEqual(search("a"), []);
+});
+
+test("a filing needs the authorization, a named signer and a real email", () => {
+  const shop = search("auto")[0];
+  assert.equal(validateFiling(good(shop)), null);
+  assert.equal(validateFiling({ ...good(shop), authorized: false }), "authorization");
+  assert.equal(validateFiling({ ...good(shop), signer: { name: "x", email: "nope" } }), "signer email");
+  assert.equal(validateFiling({ ...good(shop), wastes: [{ key: "plutonium" }] }), "waste key");
+});
+
+test("the renewal carries the shop, the waste and the signer, escaped", () => {
+  const shop = { ...search("auto")[0], name: "A <b>shop</b>" };
+  const html = renderRenewal({ ...good(shop), at: "2026-09-28T00:00:00Z" }, counties.counties[shop.county]);
+  assert.match(html, /Used motor oil/);
+  assert.match(html, /120 gal/);
+  assert.match(html, /Pat Owner/);
+  assert.ok(!html.includes("<b>shop</b>"));
+});
+
+test("nothing is submitted to a county without the env switch", async () => {
+  delete process.env.HAZWASTE_AUTOSUBMIT;
+  for (const c of Object.keys(counties.counties)) {
+    const shop = search("auto").find((s) => s.county === c) || { id: "", name: "Test", address: "", city: "", county: c };
+    const r = res();
+    await handler({ method: "POST", body: good(shop), headers: {}, socket: {} }, r);
+    assert.equal(r.code, 200, c);
+    assert.notEqual(r.body.status, "submitted", c);
+  }
+});
diff --git a/website/api/hazwaste.js b/website/api/hazwaste.js
new file mode 100644
index 00000000..653590f1
--- /dev/null
+++ b/website/api/hazwaste.js
@@ -0,0 +1,145 @@
+// THE HAZARDOUS-WASTE LICENCE RENEWAL, DONE FOR THE SHOP.
+//
+// Aidan, 2026-09-28: "we should automate end to end for counties where we can.
+// And for counties that dont we just give them the form they need to submit
+// with instructions on how to do it ... It starts as free."
+//
+// GET  /api/hazwaste?q=lake street auto   -> up to 8 shops from the public record
+// POST /api/hazwaste                      -> the filled renewal, stored, emailed
+//
+// WHAT "SUBMIT" MEANS HERE. A county whose entry in hazwaste_counties.json has
+// mode "submit" accepts the renewal from a preparer by email; for it we email
+// the county the filled renewal on the shop's authorization. Every other county
+// gets the renewal back filled in, with its own three steps. The county send is
+// ALSO gated by HAZWASTE_AUTOSUBMIT=1: until that is set in Vercel every filing
+// queues for a human read first, because the first filing a county receives from
+// a third party should be one a person checked — a wrong filing under a shop's
+// name is worse than a late one.
+//
+// IT FAILS SOFT. No Upstash, no Blob, no Mailgun: the owner still gets their
+// filled renewal on screen. Storage and mail are for us, the renewal is for them.
+
+import shopsFile from "./_data/hazwaste_shops.json" with { type: "json" };
+import countiesFile from "./_data/hazwaste_counties.json" with { type: "json" };
+import { renderRenewal, validateFiling, WASTES } from "./_lib/hazwaste.js";
+import { getClientIp } from "./_lib/rate_limit.js";
+
+const SHOPS = shopsFile.shops;
+const COUNTIES = countiesFile.counties;
+const TIMEOUT_MS = 4000;
+
+const norm = (s) => (s || "").toUpperCase().replace(/[^A-Z0-9 ]+/g, " ").replace(/\s+/g, " ").trim();
+const INDEX = SHOPS.map((s) => ({ s, hay: norm(`${s.name} ${s.address} ${s.city} ${s.zip}`) }));
+
+export function search(q, limit = 8) {
+  const terms = norm(q).split(" ").filter((t) => t.length >= 2);
+  if (!terms.length) return [];
+  const hits = [];
+  for (const { s, hay } of INDEX) {
+    if (terms.every((t) => hay.includes(t))) {
+      const nameHit = norm(s.name).startsWith(terms[0]) ? 0 : 1;
+      hits.push([nameHit, s]);
+      if (hits.length > 400) break;
+    }
+  }
+  hits.sort((a, b) => a[0] - b[0]);
+  return hits.slice(0, limit).map((h) => h[1]);
+}
+
+async function upstash(commands) {
+  const url = process.env.UPSTASH_REDIS_REST_URL, token = process.env.UPSTASH_REDIS_REST_TOKEN;
+  if (!url || !token) return null;
+  const r = await fetch(`${url}/pipeline`, {
+    method: "POST", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+    body: JSON.stringify(commands), signal: AbortSignal.timeout(TIMEOUT_MS),
+  });
+  if (!r.ok) throw new Error(`Upstash ${r.status}`);
+  return r.json();
+}
+
+async function mail({ to, subject, text, html, replyTo, attachments = [] }) {
+  const { MAILGUN_API_KEY, MAILGUN_DOMAIN, MAILGUN_FROM } = process.env;
+  if (!MAILGUN_API_KEY || !MAILGUN_DOMAIN) return false;
+  const form = new FormData();
+  form.append("from", MAILGUN_FROM || `Brick & Mortar <hello@${MAILGUN_DOMAIN}>`);
+  form.append("to", to);
+  form.append("subject", subject);
+  if (text) form.append("text", text);
+  if (html) form.append("html", html);
+  if (replyTo) form.append("h:Reply-To", replyTo);
+  for (const a of attachments) form.append("attachment", new Blob([a.data], { type: a.type }), a.filename);
+  const r = await fetch(`https://api.mailgun.net/v3/${MAILGUN_DOMAIN}/messages`, {
+    method: "POST", headers: { Authorization: "Basic " + Buffer.from(`api:${MAILGUN_API_KEY}`).toString("base64") },
+    body: form, signal: AbortSignal.timeout(8000),
+  });
+  if (!r.ok) throw new Error(`Mailgun ${r.status}`);
+  return true;
+}
+
+function resultHtml(filing, county, queued) {
+  const e = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
+  const steps = (county?.steps || []).map((s) => `<li>${e(s)}</li>`).join("");
+  const head = county?.mode === "submit"
+    ? (queued
+        ? `<h2>Done. We'll send it to ${e(county.name)} County.</h2><p>We check every filing by hand before it goes to the county, usually within one business day. You'll get a copy by email when it's sent.</p>`
+        : `<h2>Sent to ${e(county.name)} County.</h2><p>A copy is on its way to ${e(filing.signer.email)}.</p>`)
+    : `<h2>Your renewal is filled in.</h2><p>${e(county?.name || "Your")} County takes it from the shop directly, so here's what to do with it. A copy is on its way to ${e(filing.signer.email)}.</p>${steps ? `<ol>${steps}</ol>` : ""}`;
+  return `${head}<p><a href="data:text/html;charset=utf-8,${encodeURIComponent(renderRenewal(filing, county))}" download="hazwaste-renewal.html">Download your filled renewal</a></p>
+<p class="mute">Free. If there's other paperwork you'd rather not do, reply to the email and tell us.</p>`;
+}
+
+export default async function handler(req, res) {
+  res.setHeader("Cache-Control", "no-store");
+  if (req.method === "GET") {
+    const q = String(req.query?.q || "").slice(0, 80);
+    return res.status(200).json({ hits: search(q) });
+  }
+  if (req.method !== "POST") return res.status(405).json({ error: "method" });
+
+  const body = typeof req.body === "string" ? JSON.parse(req.body || "{}") : (req.body || {});
+  const problem = validateFiling(body);
+  if (problem) return res.status(400).json({ error: problem });
+
+  const known = body.shop?.id ? SHOPS.find((s) => s.id === body.shop.id) : null;
+  const shop = known || { ...body.shop, id: "", epa_id: "" };
+  const county = COUNTIES[(shop.county || "").toLowerCase()] || null;
+  const filing = {
+    id: `hw_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 7)}`,
+    at: new Date().toISOString(), ip: getClientIp(req), shop, wastes: body.wastes, signer: body.signer, authorized: true,
+    county: shop.county || "", mode: county?.mode || "guided", status: "prepared",
+  };
+  const renewal = renderRenewal(filing, county);
+  const autosubmit = county?.mode === "submit" && process.env.HAZWASTE_AUTOSUBMIT === "1" && county.submit_email;
+  filing.status = county?.mode === "submit" ? (autosubmit ? "submitted" : "queued_for_review") : "returned_to_shop";
+
+  try { await upstash([["LPUSH", "hazwaste:filings", JSON.stringify(filing)], ["INCR", `hazwaste:count:${filing.status}`]]); } catch { /* storage is for us */ }
+
+  const attach = [{ data: renewal, type: "text/html", filename: `hazwaste-renewal-${(shop.name || "shop").replace(/[^A-Za-z0-9]+/g, "-")}.html` }];
+  try {
+    if (autosubmit) {
+      await mail({
+        to: county.submit_email, replyTo: filing.signer.email,
+        subject: `Hazardous waste generator license renewal — ${shop.name}${shop.epa_id ? ` (${shop.epa_id})` : ""}`,
+        text: `Attached is the hazardous waste generator license renewal for ${shop.name}, ${shop.address}, ${shop.city}, prepared by Brick & Mortar on the business's written authorization. Signed by ${filing.signer.name}, ${filing.signer.title || "owner"}; replies go to them at ${filing.signer.email}.`,
+        attachments: attach,
+      });
+    }
+    await mail({
+      to: filing.signer.email,
+      subject: `Your hazardous waste license renewal — ${shop.name}`,
+      text: county?.mode === "submit"
+        ? `Your renewal for ${shop.name} is attached. ${autosubmit ? `We sent it to ${county.name} County.` : `We'll send it to ${county.name} County after a quick check, usually within one business day.`}\n\nFree. If there's other paperwork you'd rather not do, reply and tell us.`
+        : `Your renewal for ${shop.name} is attached, filled in.\n\n${(county?.steps || ["Send it to your county's hazardous waste licensing office."]).map((s, i) => `${i + 1}. ${s}`).join("\n")}\n\nFree. If there's other paperwork you'd rather not do, reply and tell us.`,
+      attachments: attach,
+    });
+    await mail({
+      to: process.env.NOTIFY_EMAIL || "aidan@brickandmortar.dev",
+      subject: `[hazwaste] ${filing.status} — ${shop.name} (${shop.county || "?"})`,
+      text: JSON.stringify(filing, null, 2), attachments: attach,
+    });
+  } catch { /* the owner still gets the renewal on screen */ }
+
+  return res.status(200).json({ id: filing.id, status: filing.status, html: resultHtml(filing, county, !autosubmit) });
+}
+
+export { WASTES };
