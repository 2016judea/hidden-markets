+   ],
+   "source": null
+  },
+  "ramsey": {
+   "name": "Ramsey",
+   "mode": "guided",
+   "form_name": null,
+   "form_url": null,
+   "submit_email": null,
+   "steps": [
+    "Open your county's hazardous waste licence renewal.",
+    "Copy the answers from this sheet into it.",
+    "Sign and submit it by the county's deadline."
+   ],
+   "source": null
