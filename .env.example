GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
RESEARCH_PROVIDER="gemini"
# Ceiling on billed Google Search grounding queries per calendar month. The
# first 5,000 are free; past this the provider refuses to search rather than
# search. 6,000 is about a thousand research calls and $14 worst case.
SEARCH_MONTHLY_CAP="6000"
# Client-side timeout on a Gemini request, held under undici's own 300s so a
# slow call fails with a readable message instead of "fetch failed".
GEMINI_TIMEOUT_MS="240000"
# Bounds on a job that keeps failing transiently. Blips still cost a delay
# rather than an attempt, but the delays run out.
JOB_MAX_TRANSIENT_FAILURES="8"
JOB_DEADLINE_HOURS="24"
JOB_CONCURRENCY="4"
